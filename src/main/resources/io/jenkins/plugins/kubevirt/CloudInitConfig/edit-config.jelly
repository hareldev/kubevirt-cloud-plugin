<!--
    Edit configuration page for KubeVirt Cloud-Init config files.
    Displayed when creating or editing a cloud-init config in Manage Jenkins → Managed Files.
-->
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:f="/lib/form">

    <j:set var="descriptor" value="${config.descriptor}"/>
    <st:include page="id-name-and-comment" class="${descriptor.clazz}"/>

    <f:entry title="${%Content}" help="${descriptor.getHelpFile('cloudInit')}">
        <f:textarea id="config.content" name="config.content" value="${config.content}"
                    style="height: 400px; font-family: monospace;"/>
    </f:entry>

    <f:entry>
        <j:set var="usages" value="${descriptor.usages(config.id)}"/>
        <j:choose>
            <j:when test="${!usages.isEmpty()}">
                <b>VM Templates using this cloud-init config:</b>
                <ul>
                    <j:forEach var="usage" items="${usages}">
                        <li>${usage}</li>
                    </j:forEach>
                </ul>
            </j:when>
            <j:otherwise>
                <i>This cloud-init config is not used by any VM templates yet.</i>
            </j:otherwise>
        </j:choose>
    </f:entry>

</j:jelly>
