<?jelly escape-by-default='true'?>
<!--
  Cloud configuration form for KubeVirtCloud.
  Note: VM Templates are now managed separately via the "VM Templates" menu.
-->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
    <f:entry title="${%Cloud Name}" field="name">
        <f:textbox />
    </f:entry>
    <f:entry title="${%Kubernetes Server URL}" field="serverUrl">
        <f:textbox />
    </f:entry>
    <f:entry title="${%Credentials}" field="credentialsId">
        <c:select />
    </f:entry>
    <f:entry title="${%Namespace}" field="namespace">
        <f:textbox />
    </f:entry>
    <f:entry title="${%Ignore SSL errors}" field="ignoreSsl">
        <f:checkbox />
    </f:entry>
    <f:entry title="${%VM Count Cap}" field="vmCountCap">
        <f:textbox default="10" />
    </f:entry>
    <f:entry title="${%Enable Orphan Cleanup}" field="enableOrphanCleanup">
        <f:checkbox default="true" />
    </f:entry>
    <f:validateButton title="${%Test Connection}" progress="${%Testing...}" method="testConnection" with="serverUrl,credentialsId,namespace,ignoreSsl" />
</j:jelly>
